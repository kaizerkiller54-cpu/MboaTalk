# ============================================================
# mboaTalk — Environment configuration
# ============================================================

# --- Server ---
PORT=5000
# URL publique de l'API (dev local ou URL Render/Fly en prod)
APP_URL="http://localhost:5000"
# Origines autorisées en CORS (séparées par des virgules) — ex: http://localhost:3000
CORS_ORIGIN="http://localhost:3000"

# --- Base de données (Neon PostgreSQL) ---
# Connection string PostgreSQL de votre projet Neon
# (Dashboard > votre projet > Connect > Connection string / pooled)
# Ex: postgresql://user:password@ep-xxxx-pooler.eu-west-1.aws.neon.tech/mboatalk?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mboatalk"

# --- Stockage médias (PostgreSQL/Neon) ---
# Les médias (stories, messages, documents) sont stockés dans la table `media`
# de la base PostgreSQL. Taille maximale par fichier : 2 Mo (base64).
# Les URLs servies ont la forme /api/v1/media/:id

# --- Auth / JWT ---
# Utilisez des valeurs aléatoires longues (ex: openssl rand -hex 32)
JWT_SECRET="CHANGE_ME_to_a_long_random_access_secret"
JWT_REFRESH_SECRET="CHANGE_ME_to_a_long_random_refresh_secret"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# --- Sécurité ---
# Limite du body en JSON (en 'mb')
BODY_LIMIT="50mb"
# Rate limit auth : nombre de tentatives max par fenêtre
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# --- Gemini AI (invarié, utilisé par le frontend) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"
